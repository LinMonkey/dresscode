      "sidebar-accent": "#231F33",
      "sidebar-accent-foreground": "#F3EFFF",
      "sidebar-border": "#2C2442",
      "sidebar-ring": "#B5A2FF",
      "dc-page": "#110D1D",
      "dc-surface": "#191428",
      "dc-ink": "#F3EFFF",
      "dc-muted": "#ACA3C4",
