{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sorbet",
  "type": "registry:theme",
  "title": "DressCode Sorbet",
  "description": "One big lilac hero with a sunset-orange button, then white. Light and dark, Plus Jakarta Sans, 12px controls and 18px cards.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "registryDependencies": [
    "https://dresscodeui.com/r/dresscode/font-sans-jakarta.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-sans)",
      "radius-card": "var(--dc-radius-card)"
    },
    "light": {
      "background": "#FFFFFF",
      "foreground": "#1E1240",
      "card": "#FBF8FF",
      "card-foreground": "#1E1240",
      "popover": "#FBF8FF",
      "popover-foreground": "#1E1240",
