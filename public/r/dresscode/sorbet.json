      "primary-foreground": "#FFFFFF",
      "secondary": "#EFEFF3",
      "secondary-foreground": "#1E1240",
      "muted": "#F2F2F5",
      "muted-foreground": "#635A7A",
      "accent": "#EFEFF3",
      "accent-foreground": "#1E1240",
      "destructive": "#CF3B2A",
      "border": "#ECE6F5",
      "input": "#918BAA",
      "ring": "#6A4DD6",
      "chart-1": "#6A4DD6",
      "chart-2": "#C5C3F5",
      "chart-3": "#635A7A",
      "chart-4": "#46318F",
      "chart-5": "#94718F",
      "radius": "12px",
      "sidebar": "#FBF8FF",
      "sidebar-foreground": "#1E1240",
      "sidebar-primary": "#7A5CE6",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#ECE9F3",
      "sidebar-accent-foreground": "#1E1240",
      "sidebar-border": "#ECE6F5",
      "sidebar-ring": "#6A4DD6",
      "dc-page": "#FFFFFF",
      "dc-surface": "#FBF8FF",
      "dc-ink": "#1E1240",
      "dc-muted": "#635A7A",
      "dc-line": "#ECE6F5",
      "dc-input": "#918BAA",
      "dc-primary": "#7A5CE6",
      "dc-primary-fg": "#FFFFFF",
      "dc-accent": "#6A4DD6",
      "dc-highlight": "#F2B6C6",
      "dc-highlight-fg": "#1E1240",
      "dc-danger": "#CF3B2A",
      "dc-band": "#6241D2",
      "dc-band-fg": "#FFFFFF",
      "dc-band-muted": "#D8D7F9",
      "dc-band-line": "#7968DD",
      "dc-band-edge": "#AEAAEF",
      "dc-band-primary": "#FFA51C",
      "dc-band-primary-fg": "#1E1240",
      "dc-radius-card": "18px",
      "dc-bw": "1px",
      "dc-card-border": "#ECE6F5",
      "dc-outline": "#1E1240",
      "dc-shadow": "0 1px 2px rgb(16 24 40 / 0.04), 0 10px 28px -14px rgb(16 24 40 / 0.12)",
      "dc-font-heading": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-body": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-num": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-heading-weight": "800",
      "dc-heading-tracking": "-0.035em"
    },
    "dark": {
      "background": "#110D1D",
      "foreground": "#F3EFFF",
      "card": "#191428",
      "card-foreground": "#F3EFFF",
      "popover": "#282337",
      "popover-foreground": "#F3EFFF",
      "primary": "#7A5CE6",
      "primary-foreground": "#FFFFFF",
      "secondary": "#1C1828",
      "secondary-foreground": "#F3EFFF",
      "muted": "#1A1626",
      "muted-foreground": "#ACA3C4",
