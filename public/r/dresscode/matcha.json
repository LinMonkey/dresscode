{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "matcha",
  "type": "registry:theme",
  "title": "DressCode Matcha",
  "description": "Parchment paper, book-black ink and one band of matcha green. Light and dark, Instrument Sans and Fraunces, 10px controls and 16px cards.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "registryDependencies": [
    "https://dresscodeui.com/r/dresscode/font-sans-instrument-sans.json",
    "https://dresscodeui.com/r/dresscode/font-heading-fraunces.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-sans)",
      "font-heading": "var(--font-heading)",
      "radius-card": "var(--dc-radius-card)"
    },
    "light": {
      "background": "#F5F1E6",
      "foreground": "#141414",
      "card": "#FBF9F3",
      "card-foreground": "#141414",
      "popover": "#FBF9F3",
      "popover-foreground": "#141414",
      "primary": "#141414",
      "primary-foreground": "#F5F1E6",
      "secondary": "#E5E2D8",
      "secondary-foreground": "#141414",
      "muted": "#E8E4DA",
      "muted-foreground": "#5E5848",
      "accent": "#E5E2D8",
      "accent-foreground": "#141414",
      "destructive": "#B3362B",
      "border": "#E3DCC8",
      "input": "#8E8A7F",
      "ring": "#497213",
      "chart-1": "#497213",
      "chart-2": "#B6C49F",
      "chart-3": "#5E5848",
      "chart-4": "#30451B",
      "chart-5": "#928F89",
      "radius": "10px",
      "sidebar": "#FBF9F3",
      "sidebar-foreground": "#141414",
      "sidebar-primary": "#141414",
      "sidebar-primary-foreground": "#F5F1E6",
      "sidebar-accent": "#EBE9E4",
      "sidebar-accent-foreground": "#141414",
      "sidebar-border": "#E3DCC8",
      "sidebar-ring": "#497213",
      "dc-page": "#F5F1E6",
      "dc-surface": "#FBF9F3",
      "dc-ink": "#141414",
      "dc-muted": "#5E5848",
      "dc-line": "#E3DCC8",
      "dc-input": "#8E8A7F",
      "dc-primary": "#141414",
      "dc-primary-fg": "#F5F1E6",
      "dc-accent": "#497213",
      "dc-highlight": "#A4CE46",
      "dc-highlight-fg": "#141414",
      "dc-danger": "#B3362B",
      "dc-band": "#A4CE46",
      "dc-band-fg": "#141414",
      "dc-band-muted": "#303722",
      "dc-band-line": "#87A840",
      "dc-band-edge": "#5B6F33",
      "dc-band-primary": "#141414",
      "dc-band-primary-fg": "#F5F1E6",
      "dc-radius-card": "16px",
      "dc-bw": "1px",
      "dc-card-border": "#E3DCC8",
      "dc-outline": "#141414",
      "dc-shadow": "0 1px 2px rgb(16 24 40 / 0.04), 0 10px 28px -14px rgb(16 24 40 / 0.12)",
      "dc-font-heading": "var(--font-heading), Georgia, serif",
      "dc-font-body": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-num": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-heading-weight": "560",
      "dc-heading-tracking": "-0.02em"
    },
    "dark": {
      "background": "#13130F",
      "foreground": "#EFEADB",
      "card": "#1B1B16",
      "card-foreground": "#EFEADB",
      "popover": "#2A2A25",
      "popover-foreground": "#EFEADB",
      "primary": "#EFEADB",
      "primary-foreground": "#141414",
      "secondary": "#1D1D19",
      "secondary-foreground": "#EFEADB",
      "muted": "#1C1B17",
      "muted-foreground": "#A8A291",
      "accent": "#1D1D19",
      "accent-foreground": "#EFEADB",
