{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "klein",
  "type": "registry:theme",
  "title": "DressCode Klein",
  "description": "A gallery: warm apricot paper, Klein blue for actions and big numbers. Light and dark, DM Sans and Instrument Serif, 6px controls and 10px cards.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "registryDependencies": [
    "https://dresscodeui.com/r/dresscode/font-sans-dm-sans.json",
    "https://dresscodeui.com/r/dresscode/font-heading-instrument-serif.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-sans)",
      "font-heading": "var(--font-heading)",
      "radius-card": "var(--dc-radius-card)"
    },
    "light": {
      "background": "#FCF6EE",
      "foreground": "#15163F",
      "card": "#FFFFFF",
      "card-foreground": "#15163F",
      "popover": "#FFFFFF",
      "popover-foreground": "#15163F",
      "primary": "#2E3192",
      "primary-foreground": "#FFFFFF",
      "secondary": "#ECE7E3",
      "secondary-foreground": "#15163F",
      "muted": "#EFEAE5",
      "muted-foreground": "#5E5B7F",
      "accent": "#ECE7E3",
      "accent-foreground": "#15163F",
      "destructive": "#BC3A2C",
      "border": "#EDE1D1",
      "input": "#8F8C97",
      "ring": "#2E3192",
      "chart-1": "#2E3192",
      "chart-2": "#ABB1D1",
      "chart-3": "#5E5B7F",
      "chart-4": "#8B8EA7",
      "chart-5": "#9596A6",
      "radius": "6px",
      "sidebar": "#FFFFFF",
      "sidebar-foreground": "#15163F",
      "sidebar-primary": "#2E3192",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#EFEFF3",
      "sidebar-accent-foreground": "#15163F",
      "sidebar-border": "#EDE1D1",
      "sidebar-ring": "#2E3192",
      "dc-page": "#FCF6EE",
      "dc-surface": "#FFFFFF",
      "dc-ink": "#15163F",
      "dc-muted": "#5E5B7F",
      "dc-line": "#EDE1D1",
      "dc-input": "#8F8C97",
      "dc-primary": "#2E3192",
      "dc-primary-fg": "#FFFFFF",
      "dc-accent": "#2E3192",
      "dc-highlight": "#E9E8F2",
      "dc-highlight-fg": "#2E3192",
      "dc-danger": "#BC3A2C",
      "dc-band": "#F6D3A9",
      "dc-band-fg": "#15163F",
      "dc-band-muted": "#3E3D58",
      "dc-band-line": "#C8AE97",
      "dc-band-edge": "#82767A",
      "dc-band-primary": "#2E3192",
      "dc-band-primary-fg": "#FFFFFF",
      "dc-radius-card": "10px",
      "dc-bw": "1px",
      "dc-card-border": "#EDE1D1",
      "dc-outline": "#15163F",
      "dc-shadow": "0 1px 2px rgb(16 24 40 / 0.04), 0 10px 28px -14px rgb(16 24 40 / 0.12)",
      "dc-font-heading": "var(--font-heading), Georgia, serif",
      "dc-font-body": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-num": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-heading-weight": "400",
      "dc-heading-tracking": "-0.01em"
    },
    "dark": {
      "background": "#101016",
      "foreground": "#F4EEE6",
      "card": "#17171F",
      "card-foreground": "#F4EEE6",
      "popover": "#26262E",
      "popover-foreground": "#F4EEE6",
      "primary": "#5C61F2",
      "primary-foreground": "#FFFFFF",
      "secondary": "#1B1A20",
      "secondary-foreground": "#F4EEE6",
      "muted": "#19191E",
      "muted-foreground": "#ABA7B9",
      "accent": "#1B1A20",
      "accent-foreground": "#F4EEE6",
      "destructive": "#F0735F",
      "border": "#2A2A36",
      "input": "#66646C",
      "ring": "#A3A6FF",
      "chart-1": "#A3A6FF",
      "chart-2": "#3E3F5E",
      "chart-3": "#F6D3A9",
      "chart-4": "#ABA7B9",
      "chart-5": "#C6C7F6",
      "sidebar": "#17171F",
      "sidebar-foreground": "#F4EEE6",
      "sidebar-primary": "#5C61F2",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#222129",
      "sidebar-accent-foreground": "#F4EEE6",
      "sidebar-border": "#2A2A36",
      "sidebar-ring": "#A3A6FF",
      "dc-page": "#101016",
      "dc-surface": "#17171F",
      "dc-ink": "#F4EEE6",
      "dc-muted": "#ABA7B9",
      "dc-line": "#2A2A36",
      "dc-input": "#66646C",
      "dc-primary": "#5C61F2",
      "dc-primary-fg": "#FFFFFF",
      "dc-accent": "#A3A6FF",
      "dc-highlight": "#24254D",
      "dc-highlight-fg": "#CDCFFF",
      "dc-danger": "#F0735F",
      "dc-band": "#F6D3A9",
      "dc-band-fg": "#15163F",
      "dc-band-muted": "#3E3D58",
      "dc-band-line": "#C8AE97",
      "dc-band-edge": "#82767A",
      "dc-band-primary": "#2E3192",
      "dc-band-primary-fg": "#FFFFFF",
      "dc-card-border": "#2A2A36",
      "dc-outline": "#F4EEE6",
      "dc-shadow": "inset 0 1px 0 rgb(255 255 255 / 0.04)"
    }
  },
  "css": {
    "@layer base": {
      ":root": {
        "color-scheme": "light"
      },
      ".dark": {
        "color-scheme": "dark"
      }
    },
    "@layer components": {
      ".dc-theme": {
        "background": "var(--background)",
        "color": "var(--foreground)",
        "font-family": "var(--dc-font-body)",
        "-webkit-font-smoothing": "antialiased",
        "text-rendering": "optimizeLegibility"
      },
      ".dc-h": {
        "font-family": "var(--dc-font-heading)",
        "font-weight": "var(--dc-heading-weight)",
        "letter-spacing": "var(--dc-heading-tracking)",
        "text-wrap": "balance"
      },
      ".dc-num": {
        "font-family": "var(--dc-font-num)",
        "font-variant-numeric": "tabular-nums"
      },
      ".dc-card": {
        "--foreground": "var(--dc-ink)",
        "--muted-foreground": "var(--dc-muted)",
        "--primary": "var(--dc-primary)",
        "--primary-foreground": "var(--dc-primary-fg)",
        "--border": "var(--dc-line)",
        "--input": "var(--dc-input)",
        "--dc-outline": "var(--dc-ink)",
        "background": "var(--card)",
        "color": "var(--foreground)",
        "border": "var(--dc-bw) solid var(--dc-card-border)",
        "border-radius": "var(--dc-radius-card)",
        "box-shadow": "var(--dc-shadow)"
      },
      ".dc-band": {
        "--foreground": "var(--dc-band-fg)",
        "--muted-foreground": "var(--dc-band-muted)",
        "--primary": "var(--dc-band-primary)",
        "--primary-foreground": "var(--dc-band-primary-fg)",
        "--border": "var(--dc-band-line)",
        "--input": "var(--dc-band-edge)",
        "--dc-outline": "var(--dc-band-fg)",
        "background": "var(--dc-band)",
        "color": "var(--foreground)"
      },
      ".dc-mark-highlighter": {
        "background": "linear-gradient(transparent 58%, var(--dc-highlight) 58% 92%, transparent 92%)",
        "padding": "0 0.05em",
        "margin": "0 -0.05em",
        "box-decoration-break": "clone"
      },
      ".dark .dc-mark-highlighter": {
        "background": "var(--dc-highlight)",
        "color": "var(--dc-highlight-fg)",
        "padding": "0 0.1em",
        "margin": "0 0.02em",
        "border-radius": "0.08em"
      },
      ".dc-mark-accent": {
        "color": "var(--dc-accent)"
      },
      ".dc-mark-muted": {
        "color": "var(--muted-foreground)"
      },
      ".dc-mark-italic": {
        "font-style": "italic"
      },
      ".dc-pill": {
        "display": "inline-flex",
        "align-items": "center",
        "gap": "0.25rem",
        "height": "1.375rem",
        "padding": "0 0.5rem",
        "border-radius": "999px",
        "font-size": "0.75rem",
        "font-weight": "600",
        "white-space": "nowrap"
      },
      ".dc-pill-hl": {
        "background": "var(--dc-highlight)",
        "color": "var(--dc-highlight-fg)"
      },
      ".dc-pill-danger": {
        "background": "color-mix(in oklab, var(--dc-danger) 13%, var(--card))",
        "color": "color-mix(in oklab, var(--dc-danger) 78%, var(--dc-ink))"
      },
      ".dc-pill-muted": {
        "background": "var(--muted)",
        "color": "var(--muted-foreground)"
      },
      ".dc-pill-line": {
        "box-shadow": "inset 0 0 0 1px var(--border)",
        "color": "var(--foreground)"
      },
      ".dc-icon": {
        "display": "inline-grid",
        "place-items": "center",
        "width": "2.25rem",
        "height": "2.25rem",
        "border-radius": "calc(var(--radius) + 2px)",
        "color": "var(--dc-accent)",
        "background": "color-mix(in oklab, var(--dc-accent) 11%, transparent)"
      }
    },
    ".dc-theme [data-slot=\"button\"].border-border": {
      "border-color": "var(--input)"
    },
    ".dc-band [data-slot=\"button\"].border-border:not(:hover)": {
      "background-color": "transparent"
    },
    ".dc-brutal [data-slot=\"button\"]:not(.dc-flat)": {
      "border-color": "var(--dc-outline)",
      "border-width": "1.5px",
      "box-shadow": "2px 2px 0 var(--dc-outline)"
    },
    ".dc-brutal .dc-icon": {
      "border": "1.5px solid var(--dc-outline)"
    }
  },
  "files": [
    {
      "path": "registry/dresscode/lib/dresscode-theme.ts",
      "type": "registry:lib",
      "content": "// The DressCode theme this project wears: Klein. Written by\n//   npx shadcn@latest add https://dresscodeui.com/r/dresscode/klein.json\n// Its colors (light in :root, dark in .dark), fonts and corners are CSS variables in your globals.css.\n// These are the layout choices that come with it; the templates read them.\n// Klein was designed light (mode). Put className=\"dark\" on <html> (or use next-themes) for its dark version.\nexport const dresscode = {\n  theme: \"klein\",\n  name: \"Klein\",\n  mode: \"light\",\n  layout: {\n    bandAt: \"feature\",\n    mark: \"italic\",\n    glow: false,\n    brutal: false,\n  },\n} as const\n"
    }
  ],
  "docs": "DressCode Klein is installed: both modes' colors in globals.css (:root is light, .dark is dark), the dc-* classes, and lib/dresscode-theme.ts.\nFonts: DM Sans (--font-sans), Instrument Serif (--font-heading). The CLI added the next/font calls to app/layout.tsx and their variables to <html>; outside Next.js it installs them from Fontsource. For an exact match with the demo (true italics, optical sizes), add style: [\"normal\",\"italic\"] to the Instrument_Serif(...) call in app/layout.tsx.\nKlein was designed light: add className=\"dark\" on <html> for its dark version (or use next-themes).\nTemplates: npx shadcn@latest add https://dresscodeui.com/r/dresscode/orbit-landing.json (landing page), https://dresscodeui.com/r/dresscode/orbit-app.json (app dashboard) and https://dresscodeui.com/r/dresscode/portfolio.json (personal site)\nComponents and blocks that wear it: https://dresscodeui.com/components and https://dresscodeui.com/blocks"
}
