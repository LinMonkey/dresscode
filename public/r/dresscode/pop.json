{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pop",
  "type": "registry:theme",
  "title": "DressCode Pop",
  "description": "Ink outlines and hard shadows, pink buttons, a lemon highlighter. Light and dark, DM Sans and Bricolage Grotesque, 10px controls and 14px cards.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "registryDependencies": [
    "https://dresscodeui.com/r/dresscode/font-sans-dm-sans.json",
    "https://dresscodeui.com/r/dresscode/font-heading-bricolage.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-sans)",
      "font-heading": "var(--font-heading)",
      "radius-card": "var(--dc-radius-card)"
    },
    "light": {
      "background": "#F6F5EF",
      "foreground": "#0F0F0F",
      "card": "#FFFFFF",
      "card-foreground": "#0F0F0F",
      "popover": "#FFFFFF",
      "popover-foreground": "#0F0F0F",
      "primary": "#FD6ECB",
      "primary-foreground": "#0F0F0F",
      "secondary": "#E6E5DF",
      "secondary-foreground": "#0F0F0F",
      "muted": "#E9E8E2",
      "muted-foreground": "#55554C",
      "accent": "#E6E5DF",
      "accent-foreground": "#0F0F0F",
      "destructive": "#C9261A",
      "border": "#E4E3DA",
      "input": "#8C8C87",
      "ring": "#2F7A12",
      "chart-1": "#2F7A12",
      "chart-2": "#B1CAA5",
      "chart-3": "#FD6ECB",
      "chart-4": "#55554C",
      "chart-5": "#FEEE01",
      "radius": "10px",
      "sidebar": "#FFFFFF",
      "sidebar-foreground": "#0F0F0F",
      "sidebar-primary": "#FD6ECB",
      "sidebar-primary-foreground": "#0F0F0F",
      "sidebar-accent": "#EEEEEE",
      "sidebar-accent-foreground": "#0F0F0F",
      "sidebar-border": "#E4E3DA",
      "sidebar-ring": "#2F7A12",
      "dc-page": "#F6F5EF",
      "dc-surface": "#FFFFFF",
      "dc-ink": "#0F0F0F",
      "dc-muted": "#55554C",
      "dc-line": "#E4E3DA",
      "dc-input": "#8C8C87",
      "dc-primary": "#FD6ECB",
      "dc-primary-fg": "#0F0F0F",
      "dc-accent": "#2F7A12",
      "dc-highlight": "#FEEE01",
      "dc-highlight-fg": "#0F0F0F",
      "dc-danger": "#C9261A",
      "dc-band": "#FD6ECB",
      "dc-band-fg": "#0F0F0F",
      "dc-band-muted": "#3C2332",
      "dc-band-line": "#CD5CA5",
      "dc-band-edge": "#7C3D65",
      "dc-band-primary": "#0F0F0F",
      "dc-band-primary-fg": "#FFFFFF",
      "dc-radius-card": "14px",
      "dc-bw": "1.5px",
      "dc-card-border": "#0F0F0F",
      "dc-outline": "#0F0F0F",
      "dc-shadow": "3px 3px 0 #0F0F0F",
      "dc-font-heading": "var(--font-heading), ui-sans-serif, system-ui, sans-serif",
      "dc-font-body": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-num": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-heading-weight": "800",
      "dc-heading-tracking": "-0.04em"
    },
    "dark": {
      "background": "#11110F",
      "foreground": "#F6F5EF",
      "card": "#1A1A17",
      "card-foreground": "#F6F5EF",
      "popover": "#292926",
      "popover-foreground": "#F6F5EF",
      "primary": "#FD6ECB",
      "primary-foreground": "#0F0F0F",
      "secondary": "#1C1C19",
      "secondary-foreground": "#F6F5EF",
      "muted": "#1A1A18",
      "muted-foreground": "#B3B2A7",
      "accent": "#1C1C19",
      "accent-foreground": "#F6F5EF",
      "destructive": "#FF6E5E",
      "border": "#33332D",
