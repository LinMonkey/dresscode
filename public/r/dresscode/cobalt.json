      "secondary": "#EEEFF2",
      "secondary-foreground": "#0B1030",
      "muted": "#F1F1F4",
      "muted-foreground": "#545A72",
      "accent": "#EEEFF2",
      "accent-foreground": "#0B1030",
      "destructive": "#D42F08",
      "border": "#E3E6EF",
      "input": "#878DA2",
      "ring": "#0824A8",
      "chart-1": "#0824A8",
      "chart-2": "#A0B6E6",
      "chart-3": "#545A72",
      "chart-4": "#0B1D6F",
      "chart-5": "#8F8B49",
      "radius": "8px",
      "sidebar": "#F6F7FB",
      "sidebar-foreground": "#0B1030",
      "sidebar-primary": "#0824A8",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#E6E7EE",
      "sidebar-accent-foreground": "#0B1030",
      "sidebar-border": "#E3E6EF",
      "sidebar-ring": "#0824A8",
      "dc-page": "#FFFFFF",
      "dc-surface": "#F6F7FB",
      "dc-ink": "#0B1030",
      "dc-muted": "#545A72",
      "dc-line": "#E3E6EF",
      "dc-input": "#878DA2",
      "dc-primary": "#0824A8",
      "dc-primary-fg": "#FFFFFF",
      "dc-accent": "#0824A8",
      "dc-highlight": "#FCE61E",
      "dc-highlight-fg": "#0B1030",
      "dc-danger": "#D42F08",
      "dc-band": "#0824A8",
      "dc-band-fg": "#FFFFFF",
      "dc-band-muted": "#C3D1F0",
      "dc-band-line": "#2D53BB",
      "dc-band-edge": "#6183D0",
      "dc-band-primary": "#FFFFFF",
      "dc-band-primary-fg": "#0824A8",
      "dc-radius-card": "12px",
      "dc-bw": "1px",
      "dc-card-border": "#E3E6EF",
      "dc-outline": "#0B1030",
      "dc-shadow": "0 1px 2px rgb(16 24 40 / 0.04), 0 10px 28px -14px rgb(16 24 40 / 0.12)",
      "dc-font-heading": "var(--font-heading), ui-sans-serif, system-ui, sans-serif",
      "dc-font-body": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-font-num": "var(--font-sans), ui-sans-serif, system-ui, sans-serif",
      "dc-heading-weight": "650",
      "dc-heading-tracking": "-0.03em"
    },
    "dark": {
      "background": "#080C24",
      "foreground": "#F1F3FB",
      "card": "#0F1533",
      "card-foreground": "#F1F3FB",
      "popover": "#1E2542",
      "popover-foreground": "#F1F3FB",
      "primary": "#3B5BFF",
      "primary-foreground": "#FFFFFF",
      "secondary": "#12172F",
      "secondary-foreground": "#F1F3FB",
      "muted": "#10152D",
      "muted-foreground": "#9DA4C7",
      "accent": "#12172F",
