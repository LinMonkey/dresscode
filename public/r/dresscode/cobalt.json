{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cobalt",
  "type": "registry:theme",
  "title": "DressCode Cobalt",
  "description": "White and navy ink, cobalt for every action, a yellow highlighter. Light and dark, Inter and Inter Tight, 8px controls and 12px cards.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "registryDependencies": [
    "https://dresscodeui.com/r/dresscode/font-sans-inter.json",
    "https://dresscodeui.com/r/dresscode/font-heading-inter-tight.json"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-sans)",
      "font-heading": "var(--font-heading)",
      "radius-card": "var(--dc-radius-card)"
    },
    "light": {
      "background": "#FFFFFF",
      "foreground": "#0B1030",
      "card": "#F6F7FB",
      "card-foreground": "#0B1030",
