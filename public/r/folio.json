      "ring": "#eef0ec",
      "chart-1": "#e16464",
      "chart-2": "#eef0ec",
      "chart-3": "#858e8a",
      "chart-4": "#4b534f",
      "chart-5": "#a9b1ac",
      "sidebar": "#1f2321",
      "sidebar-foreground": "#eef0ec",
      "sidebar-primary": "#e16464",
      "sidebar-primary-foreground": "#171a19",
      "sidebar-accent": "#292120",
      "sidebar-accent-foreground": "#eef0ec",
      "sidebar-border": "#4b534f",
      "sidebar-ring": "#eef0ec"
