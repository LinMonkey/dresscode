{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "folio",
  "type": "registry:theme",
  "title": "Folio",
  "description": "Folio's tokens: palette (light and dark), status colors, type scale and spacing, mapped onto shadcn's theme variables.",
  "author": "DressCode UI <https://dresscodeui.com>",
  "cssVars": {
    "theme": {
      "font-serif": "var(--font-newsreader)",
      "text-masthead": "74px",
      "text-masthead--line-height": "1",
      "text-masthead--letter-spacing": "-0.035em",
      "text-display": "67px",
      "text-display--line-height": "70px",
      "text-display--letter-spacing": "-0.035em",
      "text-h2": "64px",
      "text-h2--line-height": "1.05",
      "text-h2--letter-spacing": "-0.03em",
      "text-h3": "36px",
      "text-h3--line-height": "1.1",
      "text-h3--letter-spacing": "-0.02em",
      "text-lead-lg": "26px",
      "text-lead-lg--line-height": "32px",
      "text-lead": "25px",
      "text-lead--line-height": "31px",
      "text-nav": "18px",
      "text-nav--line-height": "1.2",
      "text-body-lg": "19px",
      "text-body-lg--line-height": "23.5px",
      "text-note": "16px",
      "text-note--line-height": "1.4",
      "spacing-section": "128px",
      "spacing-section-sm": "96px",
      "spacing-gutter": "30px",
      "spacing-heading": "56px"
    },
    "light": {
      "ink": "#171a19",
      "ink-2": "#4b524f",
      "newsprint": "#f4f5f2",
      "press": "#a32420",
      "press-tint": "#f8e3df",
      "press-deep": "#7e1916",
      "divider": "#aeb5b0",
      "hairline": "#dcdfdb",
      "rule": "#6e7877",
      "paper": "#ffffff",
      "shade": "#171a19",
      "success": "#2f6a3f",
      "success-tint": "#e3eee2",
      "warning": "#83560e",
      "warning-tint": "#f6ebd3",
      "info": "#2c4d78",
      "info-tint": "#e2e9f2",
      "neutral-tint": "#e8eae6",
      "background": "#ffffff",
      "foreground": "#171a19",
      "card": "#ffffff",
      "card-foreground": "#171a19",
      "popover": "#ffffff",
      "popover-foreground": "#171a19",
      "primary": "#171a19",
      "primary-foreground": "#ffffff",
      "secondary": "#f4f5f2",
      "secondary-foreground": "#171a19",
      "muted": "#f4f5f2",
      "muted-foreground": "#4b524f",
      "accent": "#f8e3df",
      "accent-foreground": "#171a19",
      "destructive": "#a32420",
      "border": "#dcdfdb",
      "input": "#aeb5b0",
      "ring": "#171a19",
      "radius": "0.375rem",
      "chart-1": "#a32420",
      "chart-2": "#171a19",
      "chart-3": "#6e7877",
      "chart-4": "#aeb5b0",
      "chart-5": "#4b524f",
      "sidebar": "#f4f5f2",
      "sidebar-foreground": "#171a19",
      "sidebar-primary": "#a32420",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#f8e3df",
      "sidebar-accent-foreground": "#171a19",
      "sidebar-border": "#aeb5b0",
      "sidebar-ring": "#171a19"
