  },
  "css": {
    ".folio-double-rule": {
      "height": "8px",
      "border-top": "2px solid var(--color-rule)",
      "border-bottom": "2px solid var(--color-rule)"
    },
    "@layer base": {
      ":where(button, [role=\"button\"], [role=\"tab\"], [role=\"menuitem\"], [role=\"menuitemcheckbox\"], [role=\"menuitemradio\"], [role=\"option\"], [role=\"switch\"], [role=\"checkbox\"], [role=\"radio\"], [cmdk-item], summary, select, input:is([type=\"checkbox\"], [type=\"radio\"], [type=\"file\"], [type=\"color\"], [type=\"submit\"], [type=\"button\"], [type=\"reset\"]), label:has(button, input[type=\"checkbox\"], input[type=\"radio\"], [role=\"switch\"], [role=\"checkbox\"], [role=\"radio\"])):not(:disabled, [aria-disabled=\"true\"], [data-disabled=\"\"], [data-disabled=\"true\"])": {
        "cursor": "pointer"
      }
    }
  },
  "files": [
    {
      "path": "registry/folio/lib/folio-fonts.ts",
      "type": "registry:lib",
      "content": "// Folio's two families, loaded with next/font. Put both variables on <html> in app/layout.tsx:\n//\n//   import { folioFonts } from \"@/lib/folio-fonts\"\n//   <html lang=\"en\" className={folioFonts}>\n//\n// Newsreader (with its optical-size axis) carries headlines and figures; DM Sans carries the interface.\nimport { DM_Sans, Newsreader } from \"next/font/google\"\n\nexport const newsreader = Newsreader({\n  variable: \"--font-newsreader\",\n  subsets: [\"latin\"],\n  style: [\"normal\", \"italic\"],\n  axes: [\"opsz\"],\n})\n\nexport const dmSans = DM_Sans({\n  variable: \"--font-sans\",\n  subsets: [\"latin\"],\n})\n\nexport const folioFonts = `${newsreader.variable} ${dmSans.variable}`\n"
    }
  ]
}
