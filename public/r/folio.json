      "ink-2": "#a9b1ac",
      "newsprint": "#1f2321",
      "press": "#e16464",
      "press-tint": "#292120",
      "press-deep": "#e78383",
      "divider": "#4b534f",
      "hairline": "#2d3330",
      "rule": "#858e8a",
      "paper": "#171a19",
      "shade": "#000000",
      "success": "#7cc08c",
      "success-tint": "#1d2e22",
      "warning": "#e2b25e",
      "warning-tint": "#322814",
      "info": "#8db2e3",
      "info-tint": "#1c2736",
      "neutral-tint": "#272c2a",
      "background": "#171a19",
      "foreground": "#eef0ec",
      "card": "#171a19",
      "card-foreground": "#eef0ec",
      "popover": "#1d201f",
      "popover-foreground": "#eef0ec",
      "primary": "#eef0ec",
      "primary-foreground": "#171a19",
      "secondary": "#1f2321",
      "secondary-foreground": "#eef0ec",
      "muted": "#1f2321",
