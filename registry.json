      "css": {
        ".folio-double-rule": {
          "height": "8px",
          "border-top": "2px solid var(--color-rule)",
          "border-bottom": "2px solid var(--color-rule)"
        },
        "@layer base": {
          ":where(button, [role=\"button\"], [role=\"tab\"], [role=\"menuitem\"], [role=\"menuitemcheckbox\"], [role=\"menuitemradio\"], [role=\"option\"], [role=\"switch\"], [role=\"checkbox\"], [role=\"radio\"], [cmdk-item], summary, select, input:is([type=\"checkbox\"], [type=\"radio\"], [type=\"file\"], [type=\"color\"], [type=\"submit\"], [type=\"button\"], [type=\"reset\"]), label:has(button, input[type=\"checkbox\"], input[type=\"radio\"], [role=\"switch\"], [role=\"checkbox\"], [role=\"radio\"])):not(:disabled, [aria-disabled=\"true\"], [data-disabled=\"\"], [data-disabled=\"true\"])": {
            "cursor": "pointer"
          }
        }
